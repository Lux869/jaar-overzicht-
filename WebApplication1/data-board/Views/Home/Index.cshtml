@model data_board.Models.ChartData

@{
    ViewData["Title"] = "Financieel overzicht";
    var culture = new System.Globalization.CultureInfo("nl-NL");
}

    <!--header-->

<div class="dashboard-shell">
    <div class="dashboard-header">
        <div>
            <p class="eyebrow">Financieel overzicht</p>
            <h1>Jaarresultaten</h1>
            <p class="display-10 text-muted">Inzicht in omzet, kosten en resultaat op basis van de huidige jaargegevens.</p>
        </div>
    </div>

    
    <!--dashboard-->
    
    <div class="row g-4 metric-grid">
        <div class="col-md-3 col-sm-6">
            <div class="metric-card card">
                <div class="card-body">
                    <div class="metric-label">Omzet</div>
                    <div class="metric-value success">@Model.TotalRevenue.ToString("C", culture)</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="metric-card card">
                <div class="card-body">
                    <div class="metric-label">Inkoopkosten</div>
                    <div class="metric-value danger">@Model.TotalPurchaseCosts.ToString("C", culture)</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="metric-card card">
                <div class="card-body">
                    <div class="metric-label">Administratiekosten</div>
                    <div class="metric-value warning">@Model.TotalAdministrationCosts.ToString("C", culture)</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="metric-card card">
                <div class="card-body">
                    <div class="metric-label">Bezorgkosten</div>
                    <div class="metric-value warning">@Model.TotalDeliveryCosts.ToString("C", culture)</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="metric-card card">
                <div class="card-body">
                    <div class="metric-label">Werknemerskosten</div>
                    <div class="metric-value danger">@Model.EmployeeCosts.ToString("C", culture)</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="metric-card card">
                <div class="card-body">
                    <div class="metric-label">Totale kosten</div>
                    <div class="metric-value neutral">@Model.TotalCosts.ToString("C", culture)</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="metric-card card">
                <div class="card-body">
                    <div class="metric-label">Winst</div>
                    <div class="metric-value primary">@Model.TotalProfit.ToString("C", culture)</div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="metric-card card">
                <div class="card-body">
                    <div class="metric-label">Items verkocht</div>
                    <div class="metric-value neutral">@Model.TotalItems</div>
                </div>
            </div>
        </div>
    </div>

    
    <!--grafiek-->
    
    <div class="chart-panel card mt-5">
        <div class="panel-header">
            <div>
                <p class="panel-kicker">Ontwikkeling</p>
                <h3>omzet en uitgaven</h3>
            </div>
            <div class="chart-toggle-group">
                <button id="lineChartBtn" class="chart-toggle-btn active" type="button" aria-pressed="true">Lijngrafiek</button>
                <button id="donutChartBtn" class="chart-toggle-btn" type="button" aria-pressed="false">Donutgrafiek</button>
            </div>
        </div>

        <div class="chart-layout">
            <div class="chart-wrap">
                <canvas id="financialChart"></canvas>
            </div>

            <!--maanden dingetje-->
            <div class="month-selector" aria-label="Maandoverzicht">
                @for (var i = 0; i < Model.Labels.Length; i++)
                {
                    var month = Model.Labels[i];
                    var earned = Model.ItemsSold[i] * Model.SalePrice;
                    var spend = Model.ItemsSold[i] * (Model.PurchaseCostPerItem + Model.AdministrationCostPerItem + Model.DeliveryCostPerItem);

                    <button type="button" class="month-button @(i == 0 ? "active" : "")" data-month-index="@i" aria-pressed="@(i == 0 ? "true" : "false")">
                        <span class="month-name">@month</span>
                        <span class="month-income">+ @earned.ToString("C", culture)</span>
                        <span class="month-spend">- @spend.ToString("C", culture)</span>
                    </button>
                }
            </div>
        </div>
    </div>

    
    
    <!-- meldingen centrum -->
    
    <section class="recent-activity card mt-4" aria-labelledby="notification-center-heading">
        <div class="recent-header">
            <div>
                <p class="panel-kicker">Live overzicht</p>
                <h3 id="notification-center-heading">Meldingencentrum</h3>
            </div>
            <div class="recent-statuses">
                <span class="panel-badge success">+ 11,8%</span>
            </div>
        </div>

        <div class="activity-list">
            <div class="activity-item">
                <div class="activity-badge success">A</div>
                <div class="activity-text">
                    <strong>Anna</strong>
                    <span>B2B-bestelling van 120 artikelen verwerkt</span>
                </div>
                <div class="activity-meta">
                    <span class="activity-sign positive">+</span>
                    <span class="activity-amount">€ 4.194,00</span>
                </div>
            </div>

            <div class="activity-item">
                <div class="activity-badge primary">M</div>
                <div class="activity-text">
                    <strong>Mark</strong>
                    <span>Webshopbestelling van 79 artikelen afgerond</span>
                </div>
                <div class="activity-meta">
                    <span class="activity-sign positive">+</span>
                    <span class="activity-amount">€ 2.761,05</span>
                </div>
            </div>

            <div class="activity-item">
                <div class="activity-badge neutral">L</div>
                <div class="activity-text">
                    <strong>Lisa</strong>
                    <span>Voorraadlevering van 150 artikelen goedgekeurd</span>
                </div>
                <div class="activity-meta">
                    <span class="activity-sign negative">-</span>
                    <span class="activity-amount">€ 1.920,00</span>
                </div>
            </div>

            <div class="activity-item">
                <div class="activity-badge accent">J</div>
                <div class="activity-text">
                    <strong>Jeroen</strong>
                    <span>Voorraadbestelling voor pre-workout geplaatst</span>
                </div>
                <div class="activity-meta">
                    <span class="activity-sign negative">-</span>
                    <span class="activity-amount">€ 1.408,00</span>
                </div>
            </div>

            <div class="activity-item">
                <div class="activity-badge success">S</div>
                <div class="activity-text">
                    <strong>Sanne</strong>
                    <span>Retourzending van 12 artikelen verwerkt</span>
                </div>
                <div class="activity-meta">
                    <span class="activity-sign negative">-</span>
                    <span class="activity-amount">€ 419,40</span>
                </div>
            </div>

            <div class="activity-item">
                <div class="activity-badge primary">D</div>
                <div class="activity-text">
                    <strong>David</strong>
                    <span>Nieuwe webshopbestelling van 42 artikelen</span>
                </div>
                <div class="activity-meta">
                    <span class="activity-sign positive">+</span>
                    <span class="activity-amount">€ 1.467,90</span>
                </div>
            </div>

            <div class="activity-item">
                <div class="activity-badge neutral">K</div>
                <div class="activity-text">
                    <strong>Karen</strong>
                    <span>Campagneorder met 10% promotiekorting afgerond</span>
                </div>
                <div class="activity-meta">
                    <span class="activity-sign positive">+</span>
                    <span class="activity-amount">€ 2.044,90</span>
                </div>
            </div>

            <div class="activity-item">
                <div class="activity-badge accent">R</div>
                <div class="activity-text">
                    <strong>Ruben</strong>
                    <span>Inkoop van 250 artikelen voor proteinpallets</span>
                </div>
                <div class="activity-meta">
                    <span class="activity-sign negative">-</span>
                    <span class="activity-amount">€ 3.200,00</span>
                </div>
            </div>

            <div class="activity-item">
                <div class="activity-badge success">E</div>
                <div class="activity-text">
                    <strong>Emma</strong>
                    <span>Inkooporder voor 70 vitamineartikelen afgerond</span>
                </div>
                <div class="activity-meta">
                    <span class="activity-sign negative">-</span>
                    <span class="activity-amount">€ 896,00</span>
                </div>
            </div>

            <div class="activity-item highlight">
                <div class="activity-badge accent">T</div>
                <div class="activity-text">
                    <strong>Omzet vandaag</strong>
                    <span>Alle verkoopkanalen tot nu toe</span>
                </div>
                <div class="activity-meta">
                    <span class="activity-sign positive">+</span>
                    <span class="activity-amount total">€ 18.742,60</span>
                </div>
            </div>
        </div>
        
        
        <!-- melding toevoegen -->
        
        <form id="notificationForm" class="notification-form">
            <div class="notification-form-header">
                <div>
                    <p class="panel-kicker">Nieuwe melding</p>
                    <h4>Bericht toevoegen</h4>
                </div>
                <button type="submit" class="btn btn-primary">Melding toevoegen</button>
            </div>
            <div class="notification-form-fields">
                <div>
                    <label for="notificationName">Naam</label>
                    <input id="notificationName" name="name" type="text" class="form-control" placeholder="Bijv. Anna" required />
                </div>
                <div>
                    <label for="notificationMessage">Bericht</label>
                    <input id="notificationMessage" name="message" type="text" class="form-control" placeholder="Wat is er gebeurd?" required />
                </div>
                <div>
                    <label for="notificationType">Type</label>
                    <select id="notificationType" name="type" class="form-select">
                        <option value="income">Inkomst</option>
                        <option value="expense">Uitgave</option>
                    </select>
                </div>
                <div>
                    <label for="notificationAmount">Bedrag</label>
                    <input id="notificationAmount" name="amount" type="number" class="form-control" min="0.01" step="0.01" placeholder="0,00" required />
                </div>
            </div>
        </form>
    </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const labels = @Html.Raw(Json.Serialize(Model.Labels));
    const items = @Html.Raw(Json.Serialize(Model.ItemsSold));

    const salePrice = @Model.SalePrice;
    const purchaseCost = @Model.PurchaseCostPerItem;
    const administrationCost = @Model.AdministrationCostPerItem;
    const deliveryCost = @Model.DeliveryCostPerItem;

    const revenue = items.map(item => item * salePrice);
    const expenses = items.map(item => item * (purchaseCost + administrationCost + deliveryCost));

    function calculateCumulativeValues(values) {
        return values.reduce((accumulator, value) => {
        const runningTotal = accumulator.length === 0
            ? value
            : accumulator[accumulator.length - 1] + value;

        accumulator.push(runningTotal);
        return accumulator;
    }, []);
    }

    const cumulativeRevenue = calculateCumulativeValues(revenue);
    const cumulativeExpenses = calculateCumulativeValues(expenses);

    const ctx = document.getElementById('financialChart');
    const chartGradient = ctx.getContext('2d').createLinearGradient(0, 0, 0, 320);
    chartGradient.addColorStop(0, 'rgba(59, 130, 246, 0.5)');
    chartGradient.addColorStop(1, 'rgba(59, 130, 246, 0.02)');
    const expenseGradient = ctx.getContext('2d').createLinearGradient(0, 0, 0, 320);
    expenseGradient.addColorStop(0, 'rgba(239, 68, 68, 0.25)');
    expenseGradient.addColorStop(1, 'rgba(239, 68, 68, 0.02)');

    const donutColors = [
        '#3b82f6', '#60a5fa', '#1d4ed8', '#0ea5e9', '#0891b2',
        '#06b6d4', '#22d3ee', '#f59e0b', '#fbbf24', '#10b981',
        '#ef4444', '#a78bfa'
    ];
    const expenseDonutColors = [
        '#ef4444', '#f87171', '#dc2626', '#fb7185', '#e11d48',
        '#f43f5e', '#be123c', '#b91c1c', '#991b1b', '#9f1239',
        '#fecaca', '#fda4af'
    ];

    const chartConfig = {
        line: {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'omzet',
                        data: cumulativeRevenue,
                        borderColor: '#3b82f6',
                        backgroundColor: chartGradient,
                        borderWidth: 3,
                        fill: true,
                        tension: 0.38,
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        pointBackgroundColor: '#3b82f6',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2
                    },
                    {
                        label: 'uitgaven',
                        data: cumulativeExpenses,
                        borderColor: '#ef4444',
                        backgroundColor: expenseGradient,
                        borderWidth: 3,
                        fill: true,
                        tension: 0.38,
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        pointBackgroundColor: '#ef4444',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'nearest',
                    intersect: false
                },
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': € ' + context.raw.toLocaleString('nl-NL', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                });
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false
                        },
                        border: {
                            display: false
                        }
                    },
                    y: {
                        beginAtZero: false,
                        grid: {
                            color: 'rgba(148, 163, 184, 0.18)'
                        },
                        border: {
                            display: false
                        },
                        ticks: {
                            callback: function(value) {
                                return '€ ' + value.toLocaleString('nl-NL');
                            }
                        }
                    }
                }
            }
        },
        doughnut: {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'omzet',
                        data: revenue,
                        backgroundColor: donutColors,
                        borderColor: '#ffffff',
                        borderWidth: 2,
                        hoverOffset: 8,
                        spacing: 10
                    },
                    {
                        label: 'uitgaven',
                        data: expenses,
                        backgroundColor: expenseDonutColors,
                        borderColor: '#ffffff',
                        borderWidth: 2,
                        hoverOffset: 8,
                        spacing: 10
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: {
                    title: {
                        display: true,
                        text: 'Buitenring: omzet | Binnenring: uitgaven',
                        font: {
                            size: 12,
                            weight: 'normal'
                        }
                    },
                    legend: {
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            pointStyle: 'circle',
                            boxWidth: 8,
                            padding: 12
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ' (' + context.label + '): € ' + context.raw.toLocaleString('nl-NL', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                });
                            }
                        }
                    }
                }
            }
        }
    };

    let chartMode = 'line';
    const lineChartBtn = document.getElementById('lineChartBtn');
    const donutChartBtn = document.getElementById('donutChartBtn');
    const monthButtons = document.querySelectorAll('.month-button');

    function setChartMode(mode) {
        if (chartMode === mode) {
            return;
        }

        chartMode = mode;
        financialChart.destroy();
        financialChart = new Chart(ctx, chartConfig[mode]);

        lineChartBtn.classList.toggle('active', mode === 'line');
        donutChartBtn.classList.toggle('active', mode === 'doughnut');
        lineChartBtn.setAttribute('aria-pressed', String(mode === 'line'));
        donutChartBtn.setAttribute('aria-pressed', String(mode === 'doughnut'));
    }

    function selectMonth(index) {
        monthButtons.forEach((button, buttonIndex) => {
            const isSelected = buttonIndex === index;
            button.classList.toggle('active', isSelected);
            button.setAttribute('aria-pressed', String(isSelected));
        });

        const activeElements = financialChart.data.datasets.map((_, datasetIndex) => ({
            datasetIndex: datasetIndex,
            index: index
        }));

        financialChart.setActiveElements(activeElements);
        financialChart.tooltip.setActiveElements(activeElements, { x: 0, y: 0 });
        financialChart.update();
    }

    let financialChart = new Chart(ctx, chartConfig.line);

    const notificationForm = document.getElementById('notificationForm');
    const activityList = document.querySelector('.activity-list');

    notificationForm.addEventListener('submit', event => {
        event.preventDefault();

        const formData = new FormData(notificationForm);
        const name = formData.get('name').trim();
        const message = formData.get('message').trim();
        const isIncome = formData.get('type') === 'income';
        const amount = Number(formData.get('amount'));
        const amountLabel = new Intl.NumberFormat('nl-NL', {
            style: 'currency',
            currency: 'EUR'
        }).format(amount);
        const notification = document.createElement('div');

        notification.className = 'activity-item';
        notification.innerHTML = `
            <div class="activity-badge ${isIncome ? 'success' : 'accent'}"></div>
            <div class="activity-text">
                <strong></strong>
                <span></span>
            </div>
            <div class="activity-meta">
                <span class="activity-sign ${isIncome ? 'positive' : 'negative'}">${isIncome ? '+' : '-'}</span>
                <span class="activity-amount"></span>
            </div>`;

        notification.querySelector('.activity-badge').textContent = name.charAt(0).toUpperCase();
        notification.querySelector('strong').textContent = name;
        notification.querySelector('.activity-text span').textContent = message;
        notification.querySelector('.activity-amount').textContent = amountLabel;
        activityList.prepend(notification);
        notificationForm.reset();
    });

    lineChartBtn.addEventListener('click', function () {
        setChartMode('line');
    });

    donutChartBtn.addEventListener('click', function () {
        setChartMode('doughnut');
    });

    monthButtons.forEach(button => {
        button.addEventListener('click', function () {
            selectMonth(Number(button.dataset.monthIndex));
        });
    });
</script>
